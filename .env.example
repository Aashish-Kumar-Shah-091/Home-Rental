# Django Configuration
SECRET_KEY=your-secret-key-here-change-this-for-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com,www.yourdomain.com

# Database Configuration (for Render, these will be auto-populated)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=home_rental_db
DB_USER=home_rental_user
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=5432

# Redis Configuration (for WebSocket support)
CHANNEL_REDIS_URL=redis://localhost:6379

# Email Configuration (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password-not-regular-password

# eSewa Payment Configuration
ESEWA_SECRET_KEY=your-esewa-secret-key
ESEWA_FORM_URL=https://epay.esewa.com.np/api/epay/main/v2/form
SUCCESS_URL=https://yourdomain.com/payment/success/
FAILURE_URL=https://yourdomain.com/payment/failure/

# Note for Gmail App Password:
# 1. Enable 2FA on your Gmail account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Select Mail and Windows Computer
# 4. Copy the generated password (16-character string)
# 5. Use it as EMAIL_HOST_PASSWORD (without spaces)
